# Enable or disable the entire module
AuctionSim.Enabled = 0

# Bot account id
AuctionSim.BotAccountID = 0

# Bot character guid
AuctionSim.BotCharacterID = 0

# Do a scan on server startup
AuctionSim.StartupScan = 0

# Maximum required level for items the bot will list. Items requiring a higher
# level to use are skipped before being created. 0 disables this filter.
# Useful for progression realms with a level cap below 80.
AuctionSim.MaxRequiredLevel = 0

# Maximum item level for items the bot will list. Items above this item level
# are skipped before being created. 0 disables this filter.
AuctionSim.MaxItemLevel = 0

# The percent of items in each category to list on the AH as a 4 digit number.
# For example, 0050 is 50%
# If you want duplicates set a value higher than 0100
AuctionSim.ConsumablePercent    = GREY: 0000, WHITE: 0100, GREEN: 0050, BLUE: 0050, PURPLE: 0020, ORANGE: 0000, YELLOW: 0000
AuctionSim.ContainerPercent     = GREY: 0000, WHITE: 0300, GREEN: 0200, BLUE: 0200, PURPLE: 0020, ORANGE: 0000, YELLOW: 0000
AuctionSim.WeaponPercent        = GREY: 0000, WHITE: 0000, GREEN: 0010, BLUE: 0010, PURPLE: 0020, ORANGE: 0000, YELLOW: 0000
AuctionSim.GemPercent           = GREY: 0000, WHITE: 0050, GREEN: 0050, BLUE: 0050, PURPLE: 0020, ORANGE: 0000, YELLOW: 0000
AuctionSim.ArmorPercent         = GREY: 0000, WHITE: 0000, GREEN: 0001, BLUE: 0001, PURPLE: 0001, ORANGE: 0000, YELLOW: 0000
AuctionSim.ReagentPercent       = GREY: 0000, WHITE: 0000, GREEN: 0000, BLUE: 0000, PURPLE: 0000, ORANGE: 0000, YELLOW: 0000
AuctionSim.ProjectilePercent    = GREY: 0000, WHITE: 0000, GREEN: 0300, BLUE: 0300, PURPLE: 0300, ORANGE: 0000, YELLOW: 0000
AuctionSim.TradeGoodsPercent    = GREY: 0000, WHITE: 0500, GREEN: 0500, BLUE: 0500, PURPLE: 0500, ORANGE: 0000, YELLOW: 0500
AuctionSim.GenericPercent       = GREY: 0000, WHITE: 0300, GREEN: 0000, BLUE: 0000, PURPLE: 0000, ORANGE: 0000, YELLOW: 0000
AuctionSim.RecipePercent        = GREY: 0000, WHITE: 0010, GREEN: 0010, BLUE: 0010, PURPLE: 0010, ORANGE: 0000, YELLOW: 0000
AuctionSim.MoneyPercent         = GREY: 0000, WHITE: 0000, GREEN: 0000, BLUE: 0000, PURPLE: 0000, ORANGE: 0000, YELLOW: 0000
AuctionSim.QuiverPercent        = GREY: 0000, WHITE: 0100, GREEN: 0100, BLUE: 0100, PURPLE: 0100, ORANGE: 0000, YELLOW: 0000
AuctionSim.QuestPercent         = GREY: 0000, WHITE: 0050, GREEN: 0050, BLUE: 0030, PURPLE: 0010, ORANGE: 0000, YELLOW: 0000
AuctionSim.KeyPercent           = GREY: 0000, WHITE: 0020, GREEN: 0000, BLUE: 0000, PURPLE: 0000, ORANGE: 0000, YELLOW: 0000
AuctionSim.PermanentPercent     = GREY: 0000, WHITE: 0000, GREEN: 0000, BLUE: 0000, PURPLE: 0000, ORANGE: 0000, YELLOW: 0000
AuctionSim.MiscPercent          = GREY: 0000, WHITE: 0030, GREEN: 0030, BLUE: 0030, PURPLE: 0030, ORANGE: 0000, YELLOW: 0000
AuctionSim.GlyphPercent         = GREY: 0000, WHITE: 0100, GREEN: 0000, BLUE: 0000, PURPLE: 0000, ORANGE: 0000, YELLOW: 0000
