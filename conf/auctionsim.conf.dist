# Config schema version -- DO NOT EDIT.
# The module compares this to the version it was built for and warns a GM at login
# (and in the addon window) if your auctionsim.conf is behind after a module
# update. When it warns, copy the new keys from the refreshed auctionsim.conf.dist
# (kept current in etc/modules/) into your auctionsim.conf. The module never edits
# auctionsim.conf itself; missing keys fall back to built-in defaults meanwhile.
AuctionSim.ConfigVersion = 2

# Enable or disable the entire module
AuctionSim.Enabled = 0

# Bot account id
AuctionSim.BotAccountID = 0

# Bot character guid
AuctionSim.BotCharacterID = 0

# Do a scan on server startup (in Market mode: one market step)
AuctionSim.StartupScan = 0

# What runs the auction house. Changing it needs a worldserver restart.
#
#   Replay  the bot lists and buys from auctionsim.dat, scanned prices of a real
#           market (the default; this is the module's original behaviour)
#   Market  named seller bots post and buyers buy from auctionsim_market.dat, a
#           market learned from Warmane - Lordaeron (see ml/MARKET_FORMAT.md). Each
#           faction gets AuctionSim.Market.Bots sellers whose names show in the AH.
#           Their characters are created by the module on first start, on accounts
#           named AHSIMMKTA01.. / AHSIMMKTH01.. that nobody can log into. Buyers buy
#           players' listings too: that is how players sell to the market. The
#           buyer is still the bot character set below (BotAccountID/BotCharacterID).
#           Needs a current auctionsim_market.dat next to this file; without one the
#           module refuses to run and tells GMs at login.
AuctionSim.Mode = Replay

# Market mode: named sellers per faction. Names come from auctionsim_market.dat in
# order, skipping any already taken on this realm, so fewer may be available. Market
# volume does not depend on this number, only how many names it is spread over.
# Applied at restart or with ".auctionsim market reload".
AuctionSim.Market.Bots = 100

# Market mode: market size as a fraction of Lordaeron's (1 = Lordaeron's ~60k
# auctions per faction, 0.1 = ~6k). Scales both posting and buying. The realm's
# population doesn't matter: the market works the same with 1 player or 1000.
AuctionSim.Market.Scale = 0.1

# Maximum required level for items the bot will list. Items requiring a higher
# level to use are skipped before being created. 0 disables this filter.
# Useful for progression realms with a level cap below 80.
AuctionSim.MaxRequiredLevel = 0

# Maximum item level for items the bot will list. Items above this item level
# are skipped before being created. 0 disables this filter.
AuctionSim.MaxItemLevel = 0

# Replay mode: per-category listing multiplier vs. the real market.
#
# The bot decides how full to keep each (category, quality) from real Auctioneer
# scan data baked into auctionsim.dat: it tops a category up only once its live
# auction count drops below the observed lower quartile, and never past a random
# point between that quartile and the median. These values scale that target:
#
#   1     match the real market (the default)
#   1.5   keep the category 50% fuller than the real market
#   0.5   keep it half as full
#   0     never list anything in that category/quality
#
# Plain decimals -- enter 1, 1.5, 0.25, 0. The companion addon edits the same grid.
#
# The Warmane - Lordaeron realm has a hugely saturated auction house so the values
# were uniformly scaled down to a more reasonable level.
AuctionSim.ConsumablePercent    = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.ContainerPercent     = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.WeaponPercent        = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.GemPercent           = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.ArmorPercent         = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.ReagentPercent       = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.ProjectilePercent    = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.TradeGoodsPercent    = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.GenericPercent       = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.RecipePercent        = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.MoneyPercent         = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.QuiverPercent        = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.QuestPercent         = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.KeyPercent           = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.PermanentPercent     = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.MiscPercent          = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
AuctionSim.GlyphPercent         = GREY: 0.1, WHITE: 0.1, GREEN: 0.1, BLUE: 0.1, PURPLE: 0.1, ORANGE: 0.1, YELLOW: 0.1
