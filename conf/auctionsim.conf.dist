# Enable or disable the entire module
AuctionSim.Enabled = 0

# Bot account id
AuctionSim.BotAccountID = 0

# Bot character guid
AuctionSim.BotCharacterID = 0

# Do a scan on server startup
AuctionSim.StartupScan = 0

# Maximum required level for items the bot will list. Items requiring a higher
# level to use are skipped before being created. 0 disables this filter.
# Useful for progression realms with a level cap below 80.
AuctionSim.MaxRequiredLevel = 0

# Maximum item level for items the bot will list. Items above this item level
# are skipped before being created. 0 disables this filter.
AuctionSim.MaxItemLevel = 0

# Per-category listing multiplier vs. the real market.
#
# The bot decides how full to keep each (category, quality) from real Auctioneer
# scan data baked into auctionsim.dat: it tops a category up only once its live
# auction count drops below the observed lower quartile, and never past a random
# point between that quartile and the median. These values scale that target:
#
#   1     match the real market (the default)
#   1.5   keep the category 50% fuller than the real market
#   0.5   keep it half as full
#   0     never list anything in that category/quality
#
# Plain decimals -- enter 1, 1.5, 0.25, 0. The companion addon edits the same grid.
#
# The Warmane - Lordaeron realm has a hugely saturated auction house so the values
# were uniformly scaled down to a more reasonable level.
AuctionSim.ConsumablePercent    = GREY: 0.05, WHITE: 0.05, GREEN: 0.05, BLUE: 0.05, PURPLE: 0.05, ORANGE: 0.05, YELLOW: 0.05
AuctionSim.ContainerPercent     = GREY: 0.05, WHITE: 0.05, GREEN: 0.05, BLUE: 0.05, PURPLE: 0.05, ORANGE: 0.05, YELLOW: 0.05
AuctionSim.WeaponPercent        = GREY: 0.05, WHITE: 0.05, GREEN: 0.05, BLUE: 0.05, PURPLE: 0.05, ORANGE: 0.05, YELLOW: 0.05
AuctionSim.GemPercent           = GREY: 0.05, WHITE: 0.05, GREEN: 0.05, BLUE: 0.05, PURPLE: 0.05, ORANGE: 0.05, YELLOW: 0.05
AuctionSim.ArmorPercent         = GREY: 0.05, WHITE: 0.05, GREEN: 0.05, BLUE: 0.05, PURPLE: 0.05, ORANGE: 0.05, YELLOW: 0.05
AuctionSim.ReagentPercent       = GREY: 0.05, WHITE: 0.05, GREEN: 0.05, BLUE: 0.05, PURPLE: 0.05, ORANGE: 0.05, YELLOW: 0.05
AuctionSim.ProjectilePercent    = GREY: 0.05, WHITE: 0.05, GREEN: 0.05, BLUE: 0.05, PURPLE: 0.05, ORANGE: 0.05, YELLOW: 0.05
